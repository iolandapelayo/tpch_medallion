	/// First day of the month: a real date, so charts get a continuous axis with whole labels.
	column 'Month start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: c0491e2a-282b-4b8c-a6a9-87b6a0955486
		summarizeBy: none
		sourceColumn: MONTH_START

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	partition Date = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "TPCH_WH", [Role = "TRANSFORMER"]),
				    Database = Source{[Name = "TPCH_MEDALLION", Kind = "Database"]}[Data],
				    Gold = Database{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Data = Gold{[Name = "DIM_DATE", Kind = "Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"DATE_KEY", Int64.Type}, {"YEAR", Int64.Type}, {"QUARTER", Int64.Type}, {"MONTH", Int64.Type}}),
				    WithMonth = Table.AddColumn(Typed, "MONTH_START", each Date.StartOfMonth(Date.From([FULL_DATE])), type date)
				in
				    WithMonth

