table Date
	lineageTag: 6dbbe956-c78e-4e4a-94b0-9f8fb4e97311
	dataCategory: Time

	column 'Date key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 14072e9a-fe40-4905-9c59-4fb084c67371
		summarizeBy: none
		sourceColumn: DATE_KEY

		annotation SummarizationSetBy = User

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 2e9e454e-bbe4-47f8-ab2a-1294a394457a
		summarizeBy: none
		sourceColumn: FULL_DATE

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// First day of the month: a real date, so charts get a continuous axis with whole labels.
	column 'Month start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: c0491e2a-282b-4b8c-a6a9-87b6a0955486
		summarizeBy: none
		sourceColumn: MONTH_START

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	partition 'Date' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "TPCH_WH", [Role = "TRANSFORMER"]),
				    Database = Source{[Name = "TPCH_MEDALLION", Kind = "Database"]}[Data],
				    Gold = Database{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Data = Gold{[Name = "DIM_DATE", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"DATE_KEY", "FULL_DATE"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"DATE_KEY", Int64.Type}}),
				    WithMonth = Table.AddColumn(Typed, "MONTH_START", each Date.StartOfMonth(Date.From([FULL_DATE])), type date)
				in
				    WithMonth

