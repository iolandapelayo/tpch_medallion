	partition Orders = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "TPCH_WH", [Role = "TRANSFORMER"]),
				    Database = Source{[Name = "TPCH_MEDALLION", Kind = "Database"]}[Data],
				    Gold = Database{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Data = Gold{[Name = "FCT_ORDERS", Kind = "Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"ORDER_ID", Int64.Type}, {"CUSTOMER_KEY", Int64.Type}, {"ORDER_DATE_KEY", Int64.Type}, {"ORDER_LINES", Int64.Type}, {"LATE_LINES", Int64.Type}})
				in
				    Typed

