table Orders
	lineageTag: 8ff5703b-48da-4288-a710-e30688029804

	/// Net revenue of the orders (after discount).
	measure Revenue = SUM(Orders[Net revenue])
		formatString: #,0
		lineageTag: b3a3de37-df8d-4d36-8bd9-846bac7321d9

	/// Monthly revenue of the accounts that are active today.
	measure 'Revenue active accounts' = CALCULATE([Revenue], 'Account Health'[Risk level] <> "Inactive")
		formatString: #,0
		lineageTag: a53e76a2-92b4-4576-a723-2cb9031f3d74

	/// Monthly revenue of the accounts that are high risk today.
	measure 'Revenue high-risk accounts' = CALCULATE([Revenue], 'Account Health'[Risk level] = "High")
		formatString: #,0
		lineageTag: 01a26d41-91ea-4c28-87cf-60381a2eca15

	/// Monthly revenue of the active accounts with at least one risk signal today.
	measure 'Revenue accounts at risk' = CALCULATE([Revenue], 'Account Health'[Risk level] IN {"High", "Medium"})
		formatString: #,0
		lineageTag: 2b812d7d-ab2b-47af-9911-568e43ba3b13

	column 'Customer key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5fb60532-4f61-4054-8a91-90e5d6badcef
		summarizeBy: none
		sourceColumn: CUSTOMER_KEY

		annotation SummarizationSetBy = User

	column 'Order date key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9bf76481-c5ab-4e4a-814b-f7c763e49bee
		summarizeBy: none
		sourceColumn: ORDER_DATE_KEY

		annotation SummarizationSetBy = User

	column 'Net revenue'
		dataType: double
		isHidden
		formatString: #,0
		lineageTag: aa37a4a5-3b34-4bc1-ade9-4a8c770bc13f
		summarizeBy: none
		sourceColumn: NET_REVENUE

		annotation SummarizationSetBy = User

	partition Orders = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "TPCH_WH", [Role = "TRANSFORMER"]),
				    Database = Source{[Name = "TPCH_MEDALLION", Kind = "Database"]}[Data],
				    Gold = Database{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Data = Gold{[Name = "FCT_ORDERS", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CUSTOMER_KEY", "ORDER_DATE_KEY", "NET_REVENUE"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"CUSTOMER_KEY", Int64.Type}, {"ORDER_DATE_KEY", Int64.Type}})
				in
				    Typed

