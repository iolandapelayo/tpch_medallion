table Customer
	lineageTag: ab9083e0-014b-4bc2-90e6-a9ebced9cd64

	/// Name of the account on the detail page.
	measure 'Selected customer' = SELECTEDVALUE(Customer[Customer])
		lineageTag: 5a78777a-be04-4d53-8647-41e20a47b9ec

	/// Phone of the customer in the tooltip.
	measure 'Selected phone' = SELECTEDVALUE(Customer[Phone])

	/// Address of the customer in the tooltip.
	measure 'Selected address' = SELECTEDVALUE(Customer[Address])

	/// Contact person of the customer in the tooltip.
	measure 'Selected contact person' = SELECTEDVALUE(Customer[Contact person])

	column 'Customer key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 18d55285-4515-4262-9b6c-967f68fc594b
		summarizeBy: none
		sourceColumn: CUSTOMER_KEY

		annotation SummarizationSetBy = User

	column Customer
		dataType: string
		lineageTag: 3c714c1b-27e6-48e0-8678-1cf1002f38d1
		summarizeBy: none
		sourceColumn: CUSTOMER_NAME

		annotation SummarizationSetBy = User

	column Phone
		dataType: string
		summarizeBy: none
		sourceColumn: PHONE

		annotation SummarizationSetBy = User

	/// Random text in TPC-H.
	column Address
		dataType: string
		summarizeBy: none
		sourceColumn: ADDRESS

		annotation SummarizationSetBy = User

	/// Initials. SYNTHETIC demo data: TPC-H has no contact person.
	column 'Contact person'
		dataType: string
		summarizeBy: none
		sourceColumn: CONTACT_PERSON

		annotation SummarizationSetBy = User

	partition Customer = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "TPCH_WH", [Role = "TRANSFORMER"]),
				    Database = Source{[Name = "TPCH_MEDALLION", Kind = "Database"]}[Data],
				    Gold = Database{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Data = Gold{[Name = "DIM_CUSTOMER", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CUSTOMER_KEY", "CUSTOMER_NAME", "PHONE", "ADDRESS", "CONTACT_PERSON"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"CUSTOMER_KEY", Int64.Type}})
				in
				    Typed

