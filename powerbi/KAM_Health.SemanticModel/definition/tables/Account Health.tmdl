table 'Account Health'
	lineageTag: ce0dcc0d-a388-46d8-8447-efb756757161

	/// Number of accounts (customers with at least one order).
	measure Accounts = COUNTROWS('Account Health')
		formatString: #,0
		lineageTag: d8bef22e-1964-4242-b0dd-35b83ea3b0f9

	/// Accounts with at least one order in the last 12 months.
	measure 'Active accounts' = CALCULATE([Accounts], 'Account Health'[Risk level] <> "Inactive")
		formatString: #,0
		lineageTag: 6eab78af-38ad-41d2-ac4f-3647890efda0

	/// Active accounts with 2 or 3 risk signals.
	measure 'High-risk accounts' = CALCULATE([Accounts], 'Account Health'[Risk level] = "High")
		formatString: #,0
		lineageTag: 8ba110ba-4d4e-4ea6-97d7-0f66e4506924

	/// Last-12-month revenue of active accounts with at least one risk signal.
	measure 'Total revenue at risk' = SUM('Account Health'[Revenue at risk])
		formatString: £#,0
		lineageTag: 96dabe52-7bd2-4d9c-afc4-8b1781483f1f

	/// Share of last-12-month revenue that comes from accounts at risk.
	measure '% of revenue at risk' = DIVIDE([Total revenue at risk], [Revenue last 12m total])
		formatString: 0.0%
		lineageTag: b01af25d-612c-465f-b8b3-9b1fb2aa1682

	/// Last-12-month revenue of the accounts.
	measure 'Revenue last 12m total' = SUM('Account Health'[Revenue last 12m])
		formatString: £#,0
		lineageTag: 3f6c2a91-7d4e-4b8a-9c15-6e2f8a0d4b73

	/// Revenue of the 12 months before the last 12 months.
	measure 'Revenue prev 12m total' = SUM('Account Health'[Revenue prev 12m])
		formatString: £#,0
		lineageTag: 22a5a8fd-17da-4ad7-8f1f-3bddb142e22e

	/// Last-12-month revenue vs the previous 12 months.
	measure 'Revenue change 12m' = DIVIDE([Revenue last 12m total] - [Revenue prev 12m total], [Revenue prev 12m total])
		formatString: ▲ +0.0%;▼ -0.0%;0.0%
		lineageTag: 76fd58ce-3777-4e6c-b99f-b195808334c0

	/// Revenue change 12m of the active accounts.
	measure 'Revenue change active' = CALCULATE([Revenue change 12m], 'Account Health'[Risk level] <> "Inactive")
		formatString: ▲ +0.0%;▼ -0.0%;0.0%
		lineageTag: 1fe89a43-ab84-4571-822b-71e3a7df04ac

	/// Revenue change 12m of the high-risk accounts.
	measure 'Revenue change high-risk' = CALCULATE([Revenue change 12m], 'Account Health'[Risk level] = "High")
		formatString: ▲ +0.0%;▼ -0.0%;0.0%
		lineageTag: 73504135-7686-4d8c-a7e5-f80cc52efe74

	column 'Customer key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b528393e-66d5-472e-b17d-bf725e5f0671
		summarizeBy: none
		sourceColumn: CUSTOMER_KEY

		annotation SummarizationSetBy = User

	/// A = top 20% of accounts by lifetime revenue, B = next 30%, C = rest.
	column 'Account tier'
		dataType: string
		lineageTag: db3f7115-d3f6-4af8-9863-e284273aa182
		summarizeBy: none
		sourceColumn: ACCOUNT_TIER

		annotation SummarizationSetBy = User

	column 'Revenue last 12m'
		dataType: double
		formatString: £#,0
		lineageTag: 14330251-07d5-4414-8095-954fa75c89a1
		summarizeBy: none
		sourceColumn: REVENUE_LAST_12M

		annotation SummarizationSetBy = User

	column 'Revenue prev 12m'
		dataType: double
		formatString: £#,0
		lineageTag: a422e9b2-b8f7-46a6-b84a-893e75a1fe6f
		summarizeBy: none
		sourceColumn: REVENUE_PREV_12M

		annotation SummarizationSetBy = User

	/// Revenue of the last 12 months vs the previous 12 months.
	column 'Revenue change %'
		dataType: double
		formatString: 0.0%
		lineageTag: 43457f45-92da-4bac-a4c0-4e7049e01960
		summarizeBy: none
		sourceColumn: REVENUE_CHANGE_PCT

		annotation SummarizationSetBy = User

	/// No order for more than 2x the customer's usual time between orders.
	column Overdue
		dataType: boolean
		lineageTag: 0296b921-67b2-4d0a-ae44-e2ca43434b2b
		summarizeBy: none
		sourceColumn: IS_OVERDUE

		annotation SummarizationSetBy = User

	/// Last-12-month revenue fell more than 30%.
	column Declining
		dataType: boolean
		lineageTag: c39e6cb5-0fdb-4bc8-a976-465f629d9c6b
		summarizeBy: none
		sourceColumn: IS_DECLINING

		annotation SummarizationSetBy = User

	/// In the worst 25% of accounts by late line rate.
	column 'Service issues'
		dataType: boolean
		lineageTag: c1b25886-8480-4ec2-bcb4-4aae85f54093
		summarizeBy: none
		sourceColumn: HAS_SERVICE_ISSUES

		annotation SummarizationSetBy = User

	/// Inactive (no order in 12 months), High (2-3 signals), Medium (1), Low (0).
	column 'Risk level'
		dataType: string
		lineageTag: bbc658e7-57b1-4303-aa7a-b9afda79ed09
		summarizeBy: none
		sourceColumn: RISK_LEVEL
		sortByColumn: 'Risk order'

		annotation SummarizationSetBy = User

	column 'Risk order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ad6a062a-6f78-4b2c-a670-fff182e2be4d
		summarizeBy: none
		sourceColumn: RISK_ORDER

		annotation SummarizationSetBy = User

	/// Last-12-month revenue of active accounts with at least one risk signal.
	column 'Revenue at risk'
		dataType: double
		formatString: £#,0
		lineageTag: 7bba4142-1d13-47fc-a7d0-fa9c2343ce62
		summarizeBy: none
		sourceColumn: REVENUE_AT_RISK

		annotation SummarizationSetBy = User

	column 'Risk level ES' = SWITCH('Account Health'[Risk level], "High", "Alto", "Medium", "Medio", "Low", "Bajo", "Inactive", "Inactivo", 'Account Health'[Risk level])
		dataType: string
		displayFolder: Translations
		lineageTag: 6b5011e5-ec09-4f07-a094-8ef9d57ca375
		summarizeBy: none
		sortByColumn: 'Risk order'

		annotation SummarizationSetBy = User

	column 'Risk level CA' = SWITCH('Account Health'[Risk level], "High", "Alt", "Medium", "Mitjà", "Low", "Baix", "Inactive", "Inactiu", 'Account Health'[Risk level])
		dataType: string
		displayFolder: Translations
		lineageTag: 5b4efd59-ec3f-4b87-af74-53b2cd8e8005
		summarizeBy: none
		sortByColumn: 'Risk order'

		annotation SummarizationSetBy = User

	column 'Signals EN' = SUBSTITUTE(TRIM(IF('Account Health'[Overdue], "Overdue") & " " & IF('Account Health'[Declining], "Declining") & " " & IF('Account Health'[Service issues], "Service")), " ", " · ")
		dataType: string
		displayFolder: Translations
		lineageTag: 69c997c3-012c-4eb4-8c76-3600df3c4aab
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Signals ES' = SUBSTITUTE(TRIM(IF('Account Health'[Overdue], "Retraso") & " " & IF('Account Health'[Declining], "Caída") & " " & IF('Account Health'[Service issues], "Servicio")), " ", " · ")
		dataType: string
		displayFolder: Translations
		lineageTag: b1c2ef36-657b-4efe-a4b3-8086e7e63167
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Signals CA' = SUBSTITUTE(TRIM(IF('Account Health'[Overdue], "Retard") & " " & IF('Account Health'[Declining], "Caiguda") & " " & IF('Account Health'[Service issues], "Servei")), " ", " · ")
		dataType: string
		displayFolder: Translations
		lineageTag: 3c55b6f4-63e9-49a6-80a6-c2080e13629b
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition 'Account Health' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "TPCH_WH", [Role = "TRANSFORMER"]),
				    Database = Source{[Name = "TPCH_MEDALLION", Kind = "Database"]}[Data],
				    Gold = Database{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Data = Gold{[Name = "FCT_ACCOUNT_HEALTH", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CUSTOMER_KEY", "ACCOUNT_TIER", "REVENUE_LAST_12M", "REVENUE_PREV_12M", "REVENUE_CHANGE_PCT", "IS_OVERDUE", "IS_DECLINING", "HAS_SERVICE_ISSUES", "RISK_LEVEL", "REVENUE_AT_RISK"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"CUSTOMER_KEY", Int64.Type}}),
				    WithOrder = Table.AddColumn(Typed, "RISK_ORDER", each if [RISK_LEVEL] = "High" then 1 else if [RISK_LEVEL] = "Medium" then 2 else if [RISK_LEVEL] = "Low" then 3 else 4, Int64.Type)
				in
				    WithOrder

